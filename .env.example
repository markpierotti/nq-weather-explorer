# Copy to .env and fill in. Never commit .env.

# 1. PUBLIC KEY (Maps JavaScript API & Places UI Kit).
# Sent to the browser — restrict it by HTTP referrer in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"

# 2. BACKEND KEY (Weather, Geocoding and Places REST APIs).
# Stays on the server; never sent to the browser.
GOOGLE_WEATHER_API_KEY="YOUR_GOOGLE_WEATHER_API_KEY"

# 3. Gemini (AI corridor briefing & cyclone synthesis). Optional.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# Override the Gemini model used for briefings.
# GEMINI_MODEL="gemini-4-hydrogen"

# 4. Discovery Engine CheckGrounding (optional hallucination/grounding verifier).
# Requires Discovery Engine API enabled + a service account with roles/discoveryengine.viewer
# and roles/serviceusage.serviceUsageConsumer.
# ENABLE_CHECK_GROUNDING=true
# GCP_PROJECT_ID="your-gcp-project-id"
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account-key.json"

# 5. QLDTraffic road events. Optional: falls back to the shared public key, which is
# globally rate-limited and often over quota. Request your own key from
# QLDTraffic@tmr.qld.gov.au (organisation, contact, email, application name).
# QLDTRAFFIC_API_KEY=""

# 6. Web Push (corridor alerts). Generate a VAPID key pair with:
#      npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# Optional mailto: subject for VAPID identification.
# VAPID_SUBJECT="mailto:push@nq-weather.local"

# Persistent data directory for push subscriptions, dedupe state and the forecast tracker.
# DATA_DIR="./data"

# 7. Forecast tracker (server/tracker): scores model + BOM forecasts against BOM station observations.
# SILO (Queensland Government climate data) uses an email address as its API key. Server-only.
# SILO_EMAIL=""
# The tracker runs hourly inside the server by default. On hosts that sleep between requests (Cloud Run),
# set TRACKER_SCHEDULER=off and have a scheduler POST /api/tracker/run with "Authorization: Bearer <token>".
# TRACKER_SCHEDULER=off
# TRACKER_RUN_TOKEN=""   # 16+ random characters; the run endpoint is disabled without it

# Server
# PORT=3000
# Reverse-proxy hops in front of the app (1 for nginx/Caddy, 0 if exposed directly).
# TRUST_PROXY=1
